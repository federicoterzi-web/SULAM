{
  "manifest_version": 3,
  "name": "SULAM · Expedientes del Ministerio",
  "short_name": "SULAM Expedientes",
  "version": "0.1.3",
  "description": "Lee la Bandeja de Entrada del Sistema de Expedientes del Ministerio de Desarrollo Social de Tucumán y registra los pases en la Mesa de Entrada de SULAM.",
  "permissions": ["storage"],
  "host_permissions": ["http://www.desarrollosocialtuc.gob.ar/*", "https://www.desarrollosocialtuc.gob.ar/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://www.desarrollosocialtuc.gob.ar/seds/expe/tramitesList.do*",
        "*://www.desarrollosocialtuc.gob.ar/seds/expe/expedienteVer.do*"
      ],
      "js": ["parser.js", "content.js"],
      "css": ["sulam.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "opciones.html",
  "action": { "default_title": "SULAM · Expedientes del Ministerio (opciones)", "default_icon": { "48": "iconos/48.png", "128": "iconos/128.png" } },
  "icons": { "48": "iconos/48.png", "128": "iconos/128.png" }
}
