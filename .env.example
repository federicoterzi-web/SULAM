# Copiar este archivo como .env y completar. El archivo .env NO se sube al repositorio.

# --- Con Docker ---------------------------------------------------------------
SULAM_DB_PASSWORD=cambiar-esta-clave
# Contraseña inicial del usuario "admin" (se pide cambiarla en el primer ingreso).
SULAM_ADMIN_PASSWORD=cambiar-esta-clave-tambien
# 1 = cargar usuarios y legajos FICTICIOS de demostración al iniciar.
SULAM_DATOS_DEMO=1

# --- Dirección oficial de SULAM ----------------------------------------------
# La que usan otras computadoras y celulares para entrar (va en los QR impresos).
# Con SULAM_DOMINIO no hace falta. Ejemplo en la red de la oficina:
# SULAM_URL_PUBLICA=http://192.168.0.20:8000

# --- Publicación con HTTPS (uso desde el celular) -------------------------------
# Dominio que apunta a esta máquina. Se usa con: docker compose --profile publico up -d
# SULAM_DOMINIO=sulam.ejemplo.gob.ar
# Con HTTPS, la cookie de sesión debe ser segura:
# SULAM_COOKIE_SECURE=1

# --- Sin Docker ---------------------------------------------------------------
# SULAM_DATABASE_URL=postgresql+psycopg://sulam:CLAVE@localhost:5432/sulam
# SULAM_DATA_DIR=./datos            # archivos y respaldos

# --- Opcionales ---------------------------------------------------------------
# SULAM_ENV=desarrollo              # "produccion" desactiva /api/docs y los datos demo
# SULAM_COOKIE_SECURE=0             # 1 cuando se sirva por HTTPS
# SULAM_MAX_UPLOAD_MB=20
# SULAM_SESSION_HOURS=10
# SULAM_SESSION_IDLE_MINUTES=60
# SULAM_SESSION_IDLE_MINUTES_MOVIL=15   # sesiones iniciadas desde un celular
# SULAM_MAX_FAILED_LOGINS=5
# SULAM_LOCKOUT_MINUTES=15
